generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurante {
  id                  String                @id @default(uuid()) @db.Char(36)
  nome                String                @db.VarChar(150)
  cnpj                String                @unique(map: "cnpj") @db.VarChar(14)
  status              restaurantes_status   @default(FECHADO)
  endereco_logradouro String                @db.VarChar(200)
  endereco_numero     String                @db.VarChar(20)
  endereco_bairro     String                @db.VarChar(100)
  endereco_cidade     String                @db.VarChar(100)
  endereco_cep        String                @db.VarChar(8)
  criado_em           DateTime              @default(now()) @db.Timestamp(0)
  atualizado_em       DateTime              @default(now()) @db.Timestamp(0)
  categorias_cardapio categorias_cardapio[]

  @@index([nome], map: "idx_restaurantes_nome")
  @@map("restaurantes")
}

model ItemCardapio {
  id                  String              @id @default(uuid()) @db.Char(36)
  categoria_id        String              @db.Char(36)
  nome                String              @db.VarChar(150)
  descricao           String?             @db.Text
  preco_centavos      Int
  disponivel          Boolean             @default(true)
  categorias_cardapio categorias_cardapio @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_item_categoria")

  @@index([categoria_id], map: "idx_itens_categoria_id")
  @@map("itens_cardapio")
}

model categorias_cardapio {
  id             String         @id @db.Char(36)
  restaurante_id String         @db.Char(36)
  titulo         String         @db.VarChar(100)
  restaurantes   Restaurante    @relation(fields: [restaurante_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_categoria_restaurante")
  itens_cardapio ItemCardapio[]

  @@index([restaurante_id], map: "idx_categorias_restaurante_id")
}

enum restaurantes_status {
  ABERTO
  FECHADO
  INATIVO
}
