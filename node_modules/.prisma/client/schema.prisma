generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusRestaurante {
  ABERTO
  FECHADO
  INATIVO
}

model Restaurante {
  id     String            @id @default(uuid()) @db.Char(36)
  nome   String            @db.VarChar(150)
  cnpj   String            @unique @db.VarChar(14)
  status StatusRestaurante @default(FECHADO)

  enderecoLogradouro String @map("endereco_logradouro") @db.VarChar(200)
  enderecoNumero     String @map("endereco_numero") @db.VarChar(20)
  enderecoBairro     String @map("endereco_bairro") @db.VarChar(100)
  enderecoCidade     String @map("endereco_cidade") @db.VarChar(100)
  enderecoCep        String @map("endereco_cep") @db.VarChar(8)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  categorias CategoriaCardapio[]

  @@map("restaurantes")
}

model CategoriaCardapio {
  id            String         @id @default(uuid()) @db.Char(36)
  titulo        String         @db.VarChar(100)
  restauranteId String         @map("restaurante_id") @db.Char(36)
  restaurante   Restaurante    @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  itens         ItemCardapio[]

  @@map("categorias_cardapio")
}

model ItemCardapio {
  id            String            @id @default(uuid()) @db.Char(36)
  nome          String            @db.VarChar(150)
  descricao     String?           @db.Text
  precoCentavos Int               @map("preco_centavos")
  disponivel    Boolean           @default(true)
  categoriaId   String            @map("categoria_id") @db.Char(36)
  categoria     CategoriaCardapio @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@map("itens_cardapio")
}
